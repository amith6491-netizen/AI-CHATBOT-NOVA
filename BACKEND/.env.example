# Backend Environment Variables
# For local host execution use: http://127.0.0.1:11434/api/chat
# For Docker container execution use: http://host.docker.internal:11434/api/chat
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=llama3.2

# Optional: Set an API key if using Ollama Cloud or external AI proxy
# OLLAMA_API_KEY=your_api_key_here

# Backend server port (default: 5000)
PORT=5000
