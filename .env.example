# ==========================================
# NOVA AI Chatbot - Docker Environment Configuration
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==========================================

# Port mappings on host machine
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Ollama AI Configuration
# When running in Docker, host.docker.internal reaches the host's Ollama service
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=llama3.2

# Optional: API key if using Ollama Cloud or external AI proxy (leave blank for local Ollama)
OLLAMA_API_KEY=

# Frontend API URL configuration
# Leave empty ("") to use the Nginx reverse proxy (/chat -> backend:5000/chat)
# Or set explicitly (e.g. http://localhost:5000) for direct browser-to-backend calls
VITE_API_URL=
